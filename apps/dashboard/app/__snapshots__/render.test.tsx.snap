exports[`render — LaneGraph > renders all lanes expanded, with the playhead's lane marked active 1`] = `"<div style="display:flex;flex-direction:column;gap:8px"><div style="background:var(--surface-panel);border:1px solid var(--border-default);border-radius:10px;overflow:hidden"><div title="Collapse lane" style="width:100%;display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--surface-card);text-align:left;cursor:pointer"><span style="font-size:0.72rem;font-weight:700;color:var(--text-strong);text-transform:uppercase;letter-spacing:0.05em;min-width:62px">intake / plan</span><span style="font-size:0.68rem;color:var(--status-good-text);font-weight:500">· complete</span><span style="display:flex;align-items:center;gap:3px;margin-left:auto"><span title="Product owner — intake: overview/nfrs" style="width:7px;height:7px;border-radius:50%;background:var(--role-product-owner);opacity:0.28"></span><span title="Intake gate — human approves intake" style="width:7px;height:7px;border-radius:1px;background:var(--border-strong);opacity:0.28;transform:rotate(45deg)"></span><span aria-hidden="true" title="intake · plan" style="width:1px;height:9px;background:var(--border-strong);margin:0 3px;flex:none"></span><span title="Spec author — propose features" style="width:7px;height:7px;border-radius:50%;background:var(--role-spec-author);opacity:1"></span><span title="Architect — t-shirt sizing (estimate)" style="width:7px;height:7px;border-radius:50%;background:var(--role-architect-reviewer);opacity:1"></span><span title="Backlog gate — human selects features" style="width:7px;height:7px;border-radius:1px;background:var(--border-strong);opacity:0.28;transform:rotate(45deg)"></span><span title="Product owner — author requests" style="width:7px;height:7px;border-radius:50%;background:var(--role-product-owner);opacity:0.28"></span><span title="Plan gate — human approves backlog" style="width:7px;height:7px;border-radius:1px;background:var(--border-strong);opacity:0.28;transform:rotate(45deg)"></span></span><span aria-hidden="true" style="font-size:0.7rem;color:var(--text-faint);margin-left:2px;width:10px;text-align:center">▾</span></div><div style="border-top:1px solid var(--border-default);padding:10px 12px"><div style="overflow-x:auto"><svg viewBox="0 0 936 112" width="100%" style="display:block;min-width:720px;max-height:128px" role="img" aria-label="Plan  ·  sprint planning"><defs><marker id="lg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--border-strong)"></path></marker><marker id="lg-arrow-branch" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--status-warning)"></path></marker><marker id="lg-arrow-escalation" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--status-critical)"></path></marker><marker id="lg-arrow-cycle" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--status-good-text)"></path></marker></defs><g><path d="M 118 56 H 144" fill="none" style="stroke:var(--border-strong)" stroke-width="1.4" marker-end="url(#lg-arrow)" opacity="1"></path></g><g><path d="M 252 56 H 278" fill="none" style="stroke:var(--border-strong)" stroke-width="1.4" marker-end="url(#lg-arrow)" opacity="1"></path></g><g><path d="M 386 56 H 412" fill="none" style="stroke:var(--border-strong)" stroke-width="1.4" marker-end="url(#lg-arrow)" opacity="1"></path></g><g><path d="M 520 56 H 546" fill="none" style="stroke:var(--border-strong)" stroke-width="1.4" marker-end="url(#lg-arrow)" opacity="1"></path></g><g><path d="M 654 56 H 680" fill="none" style="stroke:var(--border-strong)" stroke-width="1.4" marker-end="url(#lg-arrow)" opacity="1"></path></g><g><path d="M 788 56 H 814" fill="none" style="stroke:var(--bor