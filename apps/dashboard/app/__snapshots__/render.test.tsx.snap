exports[`render — appearance is unchanged by the token refactor > covers every AgentStatus, not just the ones this run happened to produce 1`] = `
"<div style="display:flex;flex-direction:column;gap:8px;padding:16px 18px;border-radius:14px;background:var(--status-accent-tint-soft);border:2px solid var(--status-accent);box-shadow:0 0 22px var(--status-accent)33;transition:all 0.4s ease;min-height:118px"><div style="display:flex;align-items:center;gap:10px"><div style="width:36px;height:36px;border-radius:50%;border:2px solid var(--status-accent);display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:700;color:var(--status-accent);flex-shrink:0"><svg width="22" height="22" viewBox="0 0 24 24" style="animation:spin 1.1s linear infinite"><path d="M12 3 a 9 9 0 0 1 9 9" fill="none" style="stroke:var(--status-accent)" stroke-width="3" stroke-linecap="round"></path><path d="M12 21 a 9 9 0 0 1 -9 -9" fill="none" style="stroke:var(--status-accent)" stroke-width="3" stroke-linecap="round"></path></svg></div><div style="min-width:0"><div style="font-weight:700;font-size:0.9rem;color:var(--text-strong);text-transform:uppercase;letter-spacing:0.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">orchestrator</div><div style="font-size:0.7rem;font-weight:600;color:var(--status-accent);text-transform:uppercase;letter-spacing:0.04em">working</div></div></div><div style="font-size:0.78rem;color:var(--text-body);line-height:1.35;min-height:32px">synthetic working<div style="color:var(--text-faint);font-size:0.68rem;margin-top:2px">S1-record-stock</div></div><div style="display:flex;align-items:center;gap:5px;font-size:0.68rem;color:var(--status-good-text)"><span style="width:6px;height:6px;border-radius:50%;background:var(--status-good);animation:softpulse 1.4s ease-in-out infinite"></span><span style="font-variant-numeric:tabular-nums">working 4m</span></div><div style="display:flex;justify-content:space-between;font-size:0.68rem;color:var(--text-faint);margin-top:auto"><span>0 turns</span></div></div>
<div style="display:flex;flex-direction:column;gap:8px;padding:16px 18px;border-radius:14px;background:var(--status-on-deck-tint);border:2px solid var(--status-on-deck);box-shadow:none;transition:all 0.4s ease;min-height:118px"><div style="display:flex;align-items:center;gap:10px"><div style="width:36px;height:36px;border-radius:50%;border:2px solid var(--status-on-deck);display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:700;color:var(--status-on-deck);flex-shrink:0">→</div><div style="min-width:0"><div style="font-weight:700;font-size:0.9rem;color:var(--text-strong);text-transform:uppercase;letter-spacing:0.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">orchestrator</div><div style="font-size:0.7rem;font-weight:600;color:var(--status-on-deck);text-transform:uppercase;letter-spacing:0.04em">on deck</div></div></div><div style="font-size:0.78rem;color:var(--text-body);line-height:1.35;min-height:32px">synthetic on-deck<div style="color:var(--text-faint);font-size:0.68rem;margin-top:2px">S1-record-stock</div></div><div style="display:flex;justify-content:space-between;font-size:0.68rem;color:var(--text-faint);margin-top:auto"><span>0 turns</span></div></div>
