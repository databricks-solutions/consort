exports[`render — Transport > renders REVIEWING (not PAUSED — the run keeps going) when scrubbed back off the newest event 1`] = `"<div style="background:var(--surface-panel);border:1px solid var(--border-default);border-radius:14px;padding:10px 14px;display:flex;align-items:center;gap:14px;flex-wrap:wrap"><div style="display:flex;align-items:center;gap:6px"><button title="jump to start" aria-label="jump to start" style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:500;min-width:30px">⏮</button><button title="step back one event" aria-label="step back one event" style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:500;min-width:30px">|◀</button><button title="play" aria-label="play" style="border:1px solid var(--status-play-border);background:var(--status-play);color:#ffffff;border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:700;min-width:30px">▶</button><button title="step forward one event" aria-label="step forward one event" style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:500;min-width:30px">▶|</button><button title="jump to end (follow live)" aria-label="jump to end (follow live)" style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:500;min-width:30px">⏭</button></div><input type="range" min="0" max="380" aria-label="scrub through the event log" style="flex:1;min-width:160px;accent-color:var(--status-play);cursor:pointer" value="40"/><div style="display:flex;align-items:center;gap:10px;font-size:0.7rem;color:var(--text-muted)"><span style="font-variant-numeric:tabular-nums;font-family:ui-monospace, SFMono-Regular, Menlo, monospace">40 / 380</span><span style="font-variant-numeric:tabular-nums;font-family:ui-monospace, SFMono-Regular, Menlo, monospace;color:var(--text-faint)">19:39:11</span><span style="color:var(--status-accent-text);font-weight:700">REVIEWING</span></div><div style="display:flex;align-items:center;gap:4px;font-size:0.68rem"><span style="color:var(--text-faint)">speed:</span><button style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">¼×</button><button style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">½×</button><button style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">1×</button><button style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">2×</button><button style="border:1px solid var(--border-default);background:var(--text-strong);color:var(--surface-card);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">5×</button><button style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">20×</button></div></div>"`;

