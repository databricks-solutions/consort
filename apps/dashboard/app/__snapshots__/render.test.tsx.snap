rect x="712" y="16" width="96" height="40" rx="8" style="fill:var(--surface-inset);stroke:var(--border-default)" stroke-width="1.5"></rect><text x="760" y="40" text-anchor="middle" style="font-size:10.5px;font-weight:700;fill:var(--text-faint);font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, sans-serif;text-transform:uppercase;letter-spacing:0.03em">Deploy</text><g><circle cx="760" cy="68" r="3.5" style="fill:var(--role-release-engineer)" opacity="0.35"><title>release-engineer</title></circle></g></g><g><title>deploy gate · gate: approved · not reached</title><polygon points="847,16 860,36 847,56 834,36" style="fill:var(--surface-inset);stroke:var(--border-default)" stroke-width="2"></polygon><text x="847" y="78" text-anchor="middle" style="font-size:8px;fill:var(--text-muted);font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, sans-serif;letter-spacing:0.02em">gate</text></g><g><title>Promote · not reached · release-engineer</title><rect x="886" y="16" width="96" height="40" rx="8" style="fill:var(--surface-inset);stroke:var(--border-default)" stroke-width="1.5"></rect><text x="934" y="40" text-anchor="middle" style="font-size:10.5px;font-weight:700;fill:var(--text-faint);font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, sans-serif;text-transform:uppercase;letter-spacing:0.03em">Promote</text><g><circle cx="934" cy="68" r="3.5" style="fill:var(--role-release-engineer)" opacity="0.35"><title>release-engineer</title></circle></g></g><g><title>promote gate · gate: approved · not reached</title><polygon points="1021,16 1034,36 1021,56 1008,36" style="fill:var(--surface-inset);stroke:var(--border-default)" stroke-width="2"></polygon><text x="1021" y="78" text-anchor="middle" style="font-size:8px;fill:var(--text-muted);font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, sans-serif;letter-spacing:0.02em">gate</text></g><g><title>Shipped · not reached</title><rect x="10