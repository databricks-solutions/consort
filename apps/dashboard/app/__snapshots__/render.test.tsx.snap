exports[`render — WorkflowGraph > renders the finished run: nodes reached, nothing active 1`] = `"<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:14px;padding:14px 16px;overflow-x:auto"><svg viewBox="0 0 1068 102" width="100%" style="display:block;min-width:680px;max-height:122px" role="img" aria-label="Consort lifecycle: intake through shipped"><defs><marker id="wf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--border-strong)"></path></marker><marker id="wf-arrow-done" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--status-good)"></path></marker></defs><line x1="112" y1="36" x2="134" y2="36" style="stroke:var(--border-strong)" stroke-width="1.5" marker-end="url(#wf-arrow)"></line><line x1="234" y1="36" x2="256" y2="36" style="stroke:var(--border-strong)" stroke-width="1.5" marker-end="url(#wf-arrow)"></line><line x1="286" y1="36" x2="308" y2="36" style="stroke:var(--border-strong)" stroke-width="1.5" marker-end="url(#wf-arrow)"></line><line x1="408" y1="36" x2="430" y2="36" style="stroke:var(--border-strong)" stroke-width="1.5" marker-end="url(#wf-arrow)"></line><line x1="460" y1="36" x2="482" y2="36" style="stroke:var(--border-strong)" stroke-width="1.5" marker-end="url(#wf-arrow)"></line><line x1="582" y1="36" x2="604" y2="36" style="stroke:var(--status-good)" stroke-width="2" marker-end="url(#wf-arrow-done)"></line><line x1="704" y1="36" x2="726" y2="36" style="stroke:var(--border-strong)" stroke-width="1.5" marker-end="url(#wf-arrow)"></line><line x1="756" y1="36" x2="778" y2="36" style="stroke:var(--border-strong)" stroke-width="1.5" marker-end="url(#wf-arrow)"></line><line x1="878" y1="36" x2="900" y2="36" style="stroke:var(--border-strong)" stroke-width="1.5" marker-end="url(#wf-arrow)"></line><line x1="930" y1="36" x2="952" y2="36" style