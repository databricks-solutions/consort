;border-radius:50%;background:var(--border-strong)"></span><span title="Driver — repair code, never tests" style="width:7px;height:7px;border-radius:50%;background:var(--border-strong)"></span><span title="Driver — permissive-green (superseded only)" style="width:7px;height:7px;border-radius:50%;background:var(--border-strong)"></span></span></button></div></div>"`;

exports[`render — Transport > renders following the live edge 1`] = `"<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:14px;padding:10px 14px;display:flex;align-items:center;gap:14px;flex-wrap:wrap"><div style="display:flex;align-items:center;gap:6px"><button title="jump to start" aria-label="jump to start" style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:500;min-width:30px">⏮</button><button title="step back one event" aria-label="step back one event" style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:500;min-width:30px">◀</button><button title="play" aria-label="play" style="border:1px solid var(--border-default);background:var(--status-accent);color:var(--surface-card);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:700;min-width:30px">▶</button><button disabled="" title="step forward one event" aria-label="step forward one event" style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:not-allowed;opacity:0.4;font-weight:500;min-width:30px">▶|</button><button title="follow the live edge" aria-label="follow the live edge" style="border:1px solid var(--status-good);background:var(--status-good-tint-soft);color:var(--status-good-text);border-radius:6px;padding:3px 9px;font-size:0.72rem;cursor:pointer;opacity:1;font-weight:700;min-width:30px">live</button></div><input type="range" min="0" max="380" aria-label="scrub through the event log" style="flex:1;min-width:160px;accent-color:var(--status-accent);cursor:pointer" value="380"/><div style="display:flex;align-items:center;gap:10px;font-size:0.7rem;color:var(--text-muted)"><span style="font-variant-numeric:tabular-nums;font-family:ui-monospace, SFMono-Regular, Menlo, monospace">380 / 380</span><span style="font-variant-numeric:tabular-nums;font-family:ui-monospace, SFMono-Regular, Menlo, monospace;color:var(--text-faint)">15:09:36</span><span style="display:inline-flex;align-items:center;gap:4px;color:var(--status-good);font-weight:700"><span style="width:7px;height:7px;border-radius:50%;background:var(--status-good);animation:softpulse 1.6s ease-in-out infinite"></span>LIVE</span></div><div style="display:flex;align-items:center;gap:4px;font-size:0.68rem"><span style="color:var(--text-faint)">speed:</span><button style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">1×</button><button style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">2×</button><button style="border:1px solid var(--border-default);background:var(--text-strong);color:var(--surface-card);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">5×</button><button style="border:1px solid var(--border-default);background:var(--surface-card);color:var(--text-muted);border-radius:6px;padding:2px 7px;font-size:0.66rem;cursor:pointer;font-variant-numeric:tabular-nums">20×</button></div></div>"`;

