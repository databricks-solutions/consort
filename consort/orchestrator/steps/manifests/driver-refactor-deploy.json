{
  "id": "driver-refactor-deploy",
  "role": "driver",
  "agent": {
    "kind": "claude",
    "config": {
      "role": "driver"
    }
  },
  "match": {
    "kind": "invoke-role",
    "role": "driver",
    "buildMode": "refactor-deploy"
  },
  "inputs": [
    {
      "id": "deploy-verify-scope",
      "source": "story:deploy-verify-scope.json",
      "description": "The contamination-fragile tests the Navigator flagged , the Driver edits ONLY these (no product code)."
    }
  ],
  "outputs": [],
  "routing": {
    "produced": {
      "next": "state-derived"
    }
  },
  "agentOptions": {
    "model": "opus",
    "effort": "default",
    "session": "resume",
    "resumeKeyFrom": "story"
  },
  "postTurn": [
    { "bin": "APPLY_DESIGN_THEME_BIN", "args": ["--if-guide", "--project", "{projectRoot}"], "when": "after" },
    {
      "bin": "@build-cycle",
      "args": [],
      "when": "after"
    }
  ]
}
