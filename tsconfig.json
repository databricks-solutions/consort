{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "apps/**/*.ts", "consort/**/*.ts"],
  "exclude": ["node_modules", "dist", "apps/dashboard", "consort/evaluation/reference-assets", "tests/integration/live/driver-green-setup/code-assets", "tests/integration/live/driver-green-setup/*-seed", "tests/integration/live/driver-green-setup-s2/code-assets"]
}
